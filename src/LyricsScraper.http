### Docker image: docker run -d -p 8180:8180 --name lyrics-scraper-api skuill/lyrics-scraper-api:2
@baseUrl = http://localhost:8180

### Visual Studio, "Docker Compose" profile (HTTPS with the development certificate)
#@baseUrl = https://localhost:8181

### Using for running in standalone mode (dotnet run)
#@baseUrl = http://localhost:5277

### Search lyrics by artist and song name
POST {{baseUrl}}/api/LyricsScraper
Content-Type: application/json
{
  "requestType": "ArtistAndSong",
  "artist": "Parkway Drive",
  "song": "Idols And Anchors",
  "provider": "All"
}

### Search lyrics by URI
POST {{baseUrl}}/api/LyricsScraper
Content-Type: application/json
{
  "requestType": "Uri",
  "uri": "https://genius.com/Parkway-drive-idols-and-anchors-lyrics",
  "provider": "All"
}

### Search lyrics for certain music provider (ex. SongLyrics)
POST {{baseUrl}}/api/LyricsScraper
Content-Type: application/json
{
  "requestType": "ArtistAndSong",
  "artist": "Parkway Drive",
  "song": "Wishing Wells",
  "provider": "SongLyrics"
}

### Not found: 404 with errorCode Lyric.NotFound
POST {{baseUrl}}/api/LyricsScraper
Content-Type: application/json
{
  "requestType": "ArtistAndSong",
  "artist": "Parkway Drive",
  "song": "No Such Song Qwerty"
}

### Without requestType: 400 with the available values
POST {{baseUrl}}/api/LyricsScraper
Content-Type: application/json
{
  "artist": "Parkway Drive",
  "song": "Idols And Anchors"
}
